# Copy to ~/.config/polysentinel/secrets.env and `chmod 600` it. Never commit the real file.
# Private key of the wallet that signs orders (Polymarket: Settings -> Export private key).
POLY_PK=0x...
# Your Polymarket profile/proxy address (the one holding USDC), shown in Polymarket settings.
POLY_FUNDER=0x...
# 1 = email / Magic login, 2 = browser wallet (MetaMask) proxy, 0 = plain EOA
POLY_SIG_TYPE=2
