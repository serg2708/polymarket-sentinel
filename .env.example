# ── Database ──────────────────────────────────────────────────────────────────
# Generate a strong password:  openssl rand -base64 24
# Then put the SAME value in PG_PWD and both DATABASE_URL lines below.
PG_PWD=REPLACE_WITH_openssl_rand_base64_24
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_openssl_rand_base64_24@db:5432/polysentinel
DATABASE_URL_SYNC=postgresql://postgres:REPLACE_WITH_openssl_rand_base64_24@db:5432/polysentinel

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Telegram (required) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # @BotFather token
ADMIN_CHAT_ID=              # your chat_id (get via @userinfobot)

# ── NVIDIA NIM (primary LLM — free 1000 req/day, no GPU needed) ──────────────
# Get key at: https://build.nvidia.com → any model → "Get API Key"
NVIDIA_API_KEY=             # nvapi-...
NVIDIA_MODEL=meta/llama-3.3-70b-instruct        # reasoning: tail_risk, llm_prior
NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct    # high-volume news R/L/U scoring (fast)

# ── Ollama (fallback when NVIDIA_API_KEY empty, or primary if OLLAMA_PRIMARY=true) ──
# On Linux with Docker Desktop: host is accessible at 192.168.65.2
OLLAMA_BASE_URL=http://192.168.65.2:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q8_0   # recommended for 8GB VRAM
OLLAMA_PRIMARY=true                      # use Ollama first when no NVIDIA key

# ── Claude API (optional fallback) ───────────────────────────────────────────
ANTHROPIC_API_KEY=          # sk-ant-... — leave empty to disable

# ── Kalshi (optional — enables cross-platform arb) ───────────────────────────
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_B64=   # base64-encoded PEM alternative

# ── News (optional — required for tail risk + news divergence signals) ────────
NEWSAPI_KEY=                # free tier: 100 req/day at newsapi.org

# ── Metaculus (optional — community predictions soft edge) ────────────────────
METACULUS_API_TOKEN=

# ── Polymarket ────────────────────────────────────────────────────────────────
POLYMARKET_ADDRESS=0x...    # your Ethereum wallet address

# ── Alert thresholds ──────────────────────────────────────────────────────────
ARB_MIN_EDGE_BPS=100        # min cross-platform arb edge (1%)
SOFT_EDGE_MIN_BPS=500       # min soft-edge signal (5%)
SOFT_EDGE_MIN_PP=5.0        # min absolute gap in percentage points
LIQUIDITY_SPREAD_THRESHOLD=0.15
LIQUIDITY_MIN_MID=0.10      # ignore markets below 10¢ or above 90¢

# ── Quiet hours (CET, alerts suppressed) ─────────────────────────────────────
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# ── Ingest ────────────────────────────────────────────────────────────────────
GAMMA_POLL_INTERVAL_SECONDS=300
PRICE_POLL_INTERVAL_SECONDS=10
TOP_MARKETS_BY_VOLUME=500
MAX_MARKETS_PER_EVENT=8

# Supplemental market IDs: always tracked regardless of volume rank
# ETH EOY 2026, ETH May 2026, BTC targets, etc.
SUPPLEMENTAL_MARKET_IDS=

# Market IDs to never alert on
BLOCKED_MARKET_IDS=
