[Unit]
Description=PolySentinel weekly calibration report

[Service]
Type=oneshot
WorkingDirectory=%h/dev/polymarket-sentinel/polymarket-sentinel-agent
Environment=AGENT_MODE=paper
Environment=AGENT_BANKROLL=300
ExecStartPre=/usr/bin/mkdir -p reports
ExecStart=/bin/sh -c '.venv/bin/python resolve.py --notify > reports/report-$(date +%%F).txt 2>&1'
